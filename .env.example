# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Server-only — NEVER prefix with NEXT_PUBLIC_. Used only by app/api/admin/*
# routes: managing admin accounts (create/update/delete users) and reading the
# full categories/questions lists for the panel (including is_active = false
# rows, which RLS hides from the browser client). Find it in
# Supabase Dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"